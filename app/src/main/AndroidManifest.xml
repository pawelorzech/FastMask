<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Biometric app lock (Pro). com.android.vending.BILLING is merged in by
         the Play Billing library's manifest. -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <!-- Confirms a mask created from the tile or the shortcut, and carries the
         only "Undo" button the feature has. Requested once from MainActivity,
         when a signed-in user is looking at their masks (see
         QuickMaskPolicy.shouldRequestNotificationPermission) — on Android 13+
         the permission is DENIED on a fresh install, so without asking, the
         confirmation and its Undo would never appear at all. A denial is not
         fatal: the quick-create path falls back to a Toast, so it costs the
         confirmation, not the mask. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
      Android 11+ (API 30) package visibility. Without these declarations
      PackageManager.resolveActivity() returns null for the intents below even
      when a handler is installed, so the "Contact" row and the Play-required
      Privacy / Terms links on the paywall would silently do nothing.
      See com.fastmask.ui.common.openExternalIntent.
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.SENDTO" />
            <data android:scheme="mailto" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
    </queries>

    <!--
      allowBackup="false" disables backup outright, which makes
      fullBackupContent and dataExtractionRules inert on their own. They are
      kept deliberately, not by oversight: they exclude the encrypted token
      preferences, so flipping allowBackup back on cannot silently start
      shipping the Fastmail API token to cloud backup or device transfer.
    -->
    <!--
      taskAffinity="" is a security setting, not a layout one.

      With the default affinity (the package name) any installed app can declare
      an activity with android:taskAffinity="com.fastmask" and
      allowTaskReparenting="true"; on the next FastMask launch the system
      reparents it to the top of FastMask's task and it is what the user sees
      (task hijacking / "StrandHogg"). The screen worth spoofing is the login
      screen — a single field into which the user pastes a Fastmail API token
      that grants full mailbox access. None of the existing defences apply:
      FLAG_SECURE protects screenshots, not an overlaid task, and the biometric
      LockScreen composes behind the attacker's activity.

      Android 12 (API 31) blocks cross-uid task insertion, so the exposure is
      API 26-30, which minSdk = 26 keeps in scope. QuickMaskActivity already set
      this; the activity holding the token field did not.

      An empty affinity is compatible with MainActivity's standard launch mode,
      which must stay standard so a share re-evaluates the lock (see below).
    -->
    <application
        android:name=".FastMaskApplication"
        android:allowBackup="false"
        android:taskAffinity=""
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="true"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.FastMask"
        tools:targetApi="34">

        <!--
            firebase-crashlytics pulls in firebase-sessions transitively, and
            that SDK posts a "session start" event to Google on every cold start
            and every return to the foreground — no crash involved. That is
            usage telemetry, which this app does not do, and it would make the
            privacy policy's "when the app crashes" untrue.

            The module cannot simply be excluded: CrashlyticsRegistrar calls
            FirebaseSessionsDependencies.addDependency() statically at Firebase
            component discovery, so removing the artifact breaks crash reporting
            outright. This flag is the supported way off — LocalOverrideSettings
            reads it from the application metadata and SessionsSettings honours
            it ahead of any remote configuration, so no session event is ever
            published and the SDK never listens to lifecycle events.

            What the flag does NOT stop, verified in firebase-sessions 2.0.6
            bytecode: FirebaseSessions' init coroutine calls
            SessionsSettings.updateSettings() — a fetch from
            firebase-settings.crashlytics.com carrying the installation ID,
            device model and OS build — BEFORE it reads getSessionsEnabled().
            That fetch is gated on data collection, so the crash-reports toggle
            stops it; the flag alone does not. The privacy policy discloses the
            configuration download, so this is a note for the next reader, not
            an undisclosed request.

            Crash reports are unaffected; the only loss is the crash-free-users
            percentage in the Firebase console.
        -->
        <meta-data
            android:name="firebase_sessions_enabled"
            android:value="false" />

        <!-- Shares the CSV mask export (Pro) from cacheDir/exports — no storage
             permissions, receiver gets a one-off read grant. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.FastMask.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Keep MainActivity standard: a share must start a fresh instance
                 so the biometric gate is re-evaluated; singleTop/singleTask
                 could deliver into an Activity whose lock state was decided earlier. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>

            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <!--
          exported="false" is a security requirement, not a default.

          Exported (as this was) and with no intent-filter, ANY app on the
          device could `startActivity` it with zero permissions and zero user
          interaction, and FastMask — a confused deputy holding the user's
          Fastmail token — would mint a real mask on their account and
          overwrite the clipboard, in a loop if asked.

          The launcher shortcut does not need the export: the system starts
          shortcuts through LauncherApps#startShortcut, which runs the intent
          as the publishing package, so the caller is FastMask itself.
          QuickMaskActivity additionally refuses to create for any intent that
          does not carry ACTION_QUICK_MASK.
        -->
        <activity
            android:name=".quickmask.QuickMaskActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@style/Theme.FastMask.Invisible" />

        <receiver
            android:name=".quickmask.QuickMaskUndoReceiver"
            android:exported="false" />

        <service
            android:name=".quickmask.QuickMaskTileService"
            android:exported="true"
            android:icon="@drawable/ic_quick_mask"
            android:label="@string/quick_mask_tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
    </application>

</manifest>
