<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Dark mode: a dark splash, so a night-time launch is not a flash of amber. -->
    <style name="Theme.FastMask.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash_background_night</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.FastMask</item>
    </style>
</resources>
