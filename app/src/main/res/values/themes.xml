<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      No statusBarColor / navigationBarColor / windowLightStatusBar here.

      Window.setStatusBarColor and setNavigationBarColor are deprecated in
      Android 15 and ignored from API 35 — Play names both on this app's
      release. enableEdgeToEdge() in MainActivity configures the bars at
      runtime on every supported API level, so these attributes were redundant
      rather than broken: the runtime call already overrode them, including
      windowLightStatusBar, which was hardcoded true and would otherwise have
      put dark icons on a dark background. Verified on API 36 in both themes —
      dark icons on light, light icons on dark.
    -->
    <style name="Theme.FastMask" parent="Theme.AppCompat.DayNight.NoActionBar" />

    <!--
      The splash icon is the VECTOR copy of the launcher mark, not
      drawable-*/ic_launcher_foreground.png. That PNG only exists in
      density-qualified folders, and Play splits an AAB by density, so a device
      without its density split has the R id but nothing behind it — the same
      missing 0x7f080077 that crashed the welcome screen in 1.10.1. A vector
      carries no density qualifier and ships in the base split, so the very
      first frame of the app cannot depend on split delivery.
    -->
    <style name="Theme.FastMask.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_shortcut_quick_mask_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.FastMask</item>
    </style>

    <style name="Theme.FastMask.Invisible" parent="Theme.FastMask">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="windowNoTitle">true</item>
        <item name="android:windowAnimationStyle">@null</item>
    </style>
</resources>
